{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!data\\.xlsx$|.*\\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/data.xlsx",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=43200, s-maxage=43200, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
